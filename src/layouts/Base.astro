---
import '../styles/global.css';
import { site } from '../data/site';
import logoFont from '../assets/fonts/uncage-bold.woff2?url';
import logoSubFont from '../assets/fonts/gilroy-light.woff2?url';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${site.name} — ${site.role} · торты на заказ, ${site.city}`,
  description = `${site.tagline}. Бисквитные торты от 3000 ₽/кг, бенто от 1900 ₽, трайфлы, капкейки, кейкпопсы и другие десерты.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Пока в контенте есть заглушки (контакты, отзывы), закрываем сайт от индексации.
// TODO: поставить false, когда заполним реальные данные.
const noindex = true;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: `${site.brand} — ${site.role}`,
  description,
  url: canonical.href,
  telephone: site.contacts.phone,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'RU' },
  sameAs: [`https://instagram.com/${site.contacts.instagram}`, ...(site.contacts.telegram ? [`https://t.me/${site.contacts.telegram}`] : [])],
  priceRange: '₽₽',
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7eee8" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site ?? site.url)} />

    <link rel="preload" href={logoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={logoSubFont} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Onest:wght@400;500;600;700;800;900&display=swap"
    />

    <script is:inline>
      // включаем стартовые состояния анимаций только если движение разрешено
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-anim');
        // страховка: если скрипт анимаций не загрузился, показываем контент как есть
        setTimeout(function () {
          if (!window.__animReady) document.documentElement.classList.remove('js-anim');
        }, 4000);
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import '../scripts/order.ts';
      import '../scripts/ui.ts';
      import '../scripts/animations.ts';
    </script>
  </body>
</html>
