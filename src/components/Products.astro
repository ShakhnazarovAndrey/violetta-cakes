---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionTitle from './SectionTitle.astro';
import Doodle from './Doodle.astro';
import Icon from './Icon.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section products" id="menu">
  <div class="container">
    <SectionTitle solid="Вы можете" ghost="заказать" align="center" />

    <ul class="products__grid">
      {products.map(({ data }, i) => (
        <li class="product" data-reveal style={`--i:${i}`}>
          <a class="product__link" href={data.link}>
            <span class="product__pic">
              <Doodle variant="loop" class="product__loop" />
              <Image src={data.image} alt={data.name} widths={[360, 560, 800]} sizes="(max-width: 700px) 90vw, 380px" style={data.link === '#desserts' ? 'object-position: 90% 50%' : undefined} />
              <span class="price-badge product__badge">{data.badge}</span>
            </span>
            <h3>{data.name}</h3>
            <p>{data.text}</p>
            <span class="product__more">смотреть <Icon name="arrow" /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .products__grid {
    list-style: none; margin: clamp(40px, 6vw, 80px) auto 0; padding: 0; max-width: 1180px;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px);
  }
  .product:nth-child(2) { margin-top: clamp(0px, 6vw, 72px); }
  .product__link { display: grid; gap: 12px; text-decoration: none; justify-items: start; }
  .product__pic {
    position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; margin-bottom: 8px;
    transition: transform 0.6s var(--ease-spring);
  }
  .product__link:hover .product__pic { transform: translateY(-8px) rotate(-1.5deg); }
  .product__pic :global(img) {
    position: relative; width: 100%; height: 100%; object-fit: cover;
    border-radius: 46% 54% 32px 32px / 32% 32% 32px 32px;
  }
  .product__loop { position: absolute; inset: -5%; width: 110%; height: 110%; color: var(--rose); }
  .product__badge { position: absolute; top: 8%; right: -2%; z-index: 1; transform: rotate(6deg); }
  .product h3 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; letter-spacing: -0.03em; color: var(--berry); }
  .product p { color: var(--ink-soft); max-width: 40ch; }
  .product__more { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--berry); }
  .product__more :global(svg) { width: 20px; transition: transform 0.4s var(--ease-spring); }
  .product__link:hover .product__more :global(svg) { transform: translateX(6px); }

  @media (max-width: 900px) { .products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .products__grid { grid-template-columns: 1fr; }
    .product:nth-child(2) { margin-top: 0; }
    .product__pic { width: min(100%, 360px); }
  }
</style>
