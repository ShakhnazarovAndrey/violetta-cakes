---
// Плоские иллюстрации изделий — заглушки до реальных фото.
interface Props {
  name: 'cake' | 'bento' | 'cupcake' | 'cookie';
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<svg class:list={['illu', cls]} viewBox="0 0 240 220" aria-hidden="true">
  <ellipse cx="120" cy="204" rx="92" ry="10" fill="#000" opacity="0.08"></ellipse>
  {name === 'cake' && (
    <g>
      <rect x="38" y="118" width="164" height="82" rx="14" fill="#f8dfe4"></rect>
      <rect x="66" y="58" width="108" height="66" rx="12" fill="#fffaf3"></rect>
      <path d="M66 76c0-10 6-18 16-18h76c10 0 16 8 16 18 0 8-6 10-8 2-2 12-12 12-13 0-2 14-14 14-15 0-2 10-12 10-13 0-2 12-13 12-14 0-2 10-12 10-13 0-2 10-12 10-14 0-2 6-6 6-6 0z" fill="#e48ba4"></path>
      <path d="M38 136c0-10 6-18 16-18h132c10 0 16 8 16 18 0 8-6 10-8 2-2 14-13 14-14 0-2 16-16 16-17 0-2 12-14 12-15 0-2 14-15 14-16 0-2 12-14 12-15 0-2 14-15 14-16 0-2 12-14 12-15 0-2 6-8 6-8 0z" fill="#8e1b3a"></path>
      <g fill="#fff" opacity="0.9">
        <circle cx="70" cy="176" r="4"></circle><circle cx="100" cy="182" r="4"></circle><circle cx="130" cy="176" r="4"></circle><circle cx="160" cy="182" r="4"></circle><circle cx="186" cy="176" r="4"></circle>
      </g>
      <circle cx="120" cy="46" r="13" fill="#c9184a"></circle>
      <circle cx="116" cy="42" r="4" fill="#fff" opacity="0.5"></circle>
      <path d="M120 34c2-10 8-16 16-18" stroke="#4f7a3a" stroke-width="3" fill="none" stroke-linecap="round"></path>
    </g>
  )}
  {name === 'bento' && (
    <g>
      <path d="M40 92h160l-10 108H50z" fill="#d9b48a"></path>
      <path d="M40 92h160l-8 22H48z" fill="#c79d6f"></path>
      <rect x="70" y="104" width="100" height="66" rx="30" fill="#f8dfe4"></rect>
      <path d="M70 128c0-14 10-24 24-24h52c14 0 24 10 24 24 0 6-5 8-7 2-2 10-10 10-11 0-2 12-12 12-13 0-2 10-11 10-12 0-2 12-12 12-13 0-2 8-9 8-10 0-2 6-6 6-6 0z" fill="#fffaf3"></path>
      <text x="120" y="160" text-anchor="middle" font-family="Caveat, cursive" font-size="22" font-weight="700" fill="#8e1b3a">love</text>
      <path d="M36 92l20-40h128l20 40" fill="#e7c9a6" opacity="0.7"></path>
      <path d="M84 70h72" stroke="#8e1b3a" stroke-width="3" stroke-linecap="round"></path>
    </g>
  )}
  {name === 'cupcake' && (
    <g>
      <path d="M66 124h108l-14 76H80z" fill="#8e1b3a"></path>
      <g stroke="#6a0f27" stroke-width="3">
        <path d="M88 126l6 74"></path><path d="M108 126l3 74"></path><path d="M132 126l-3 74"></path><path d="M152 126l-6 74"></path>
      </g>
      <path d="M58 126c-6-20 10-34 26-32-4-24 22-40 40-28 14-16 46-8 44 18 20 0 30 22 18 42z" fill="#f8dfe4"></path>
      <path d="M74 112c20 6 70 8 92-4M84 92c18 8 50 8 70-2" stroke="#e48ba4" stroke-width="4" fill="none" stroke-linecap="round"></path>
      <circle cx="122" cy="52" r="14" fill="#c9184a"></circle>
      <circle cx="118" cy="48" r="4" fill="#fff" opacity="0.5"></circle>
      <path d="M122 38c4-12 12-18 22-18" stroke="#4f7a3a" stroke-width="3" fill="none" stroke-linecap="round"></path>
    </g>
  )}
  {name === 'cookie' && (
    <g>
      <circle cx="104" cy="128" r="66" fill="#d9a066"></circle>
      <circle cx="104" cy="128" r="66" fill="none" stroke="#b97e43" stroke-width="6" opacity="0.5"></circle>
      <g fill="#5a2c1b">
        <path d="M80 100l10-4 4 10-10 4z"></path><path d="M120 92l10 2-2 10-10-2z"></path><path d="M70 140l10 2-2 10-10-2z"></path>
        <path d="M112 132l10-4 4 10-10 4z"></path><path d="M140 150l8 6-6 8-8-6z"></path><path d="M98 166l10 0 0 10-10 0z"></path>
      </g>
      <g fill="#e23a55">
        <circle cx="140" cy="112" r="5"></circle><circle cx="92" cy="122" r="4"></circle><circle cx="122" cy="168" r="4"></circle>
      </g>
      <circle cx="176" cy="160" r="34" fill="#e9b97e"></circle>
      <g fill="#5a2c1b"><path d="M166 150l8-2 2 8-8 2z"></path><path d="M182 168l8 2-2 8-8-2z"></path></g>
    </g>
  )}
</svg>

<style>
  .illu { width: 100%; height: auto; overflow: visible; }
</style>
