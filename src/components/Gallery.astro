---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionTitle from './SectionTitle.astro';

// Фото работ: просто положите файлы в src/assets/gallery/ — они появятся здесь автоматически.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

---

<section class="section gallery" id="works">
  <div class="container">
    <div class="gallery__head">
      <SectionTitle solid="Мои" ghost="работы" />
      <p>Каждый торт — под конкретный праздник и человека. Нажмите на фото, чтобы рассмотреть поближе.</p>
    </div>

    <ul class="gallery__grid">
      {photos.map((src, i) => (
            <li class="gallery__item" data-reveal>
              <button type="button" class="gallery__btn" data-lightbox={i} aria-label={`Открыть фото ${i + 1}`}>
                <Image src={src} alt={`Работа ${i + 1}`} widths={[360, 640, 1100]} sizes="(max-width: 700px) 50vw, 33vw" />
              </button>
            </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Просмотр работы">
    <div class="lightbox__stage" data-lightbox-stage></div>
    <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Предыдущее">‹</button>
    <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Следующее">›</button>
    <button class="lightbox__close" type="button" data-close aria-label="Закрыть">×</button>
  </dialog>
</section>

<style>
  .gallery__head { display: grid; grid-template-columns: 1fr minmax(0, 360px); align-items: end; gap: 16px 40px; }
  .gallery__head p { color: var(--ink-soft); }
  .gallery__grid { list-style: none; margin: clamp(32px, 5vw, 56px) 0 0; padding: 0; columns: 3; column-gap: clamp(12px, 2vw, 24px); }
  .gallery__item { break-inside: avoid; margin-bottom: clamp(12px, 2vw, 24px); }
  .gallery__btn {
    display: block; width: 100%; padding: 0; border: 0; background: none; overflow: hidden;
    border-radius: var(--radius-m); cursor: zoom-in;
  }
  .gallery__btn :global(img) { width: 100%; transition: transform 0.8s var(--ease-out); }
  .gallery__btn:hover :global(img) { transform: scale(1.05); }

  .lightbox { width: 100vw; height: 100svh; margin: 0; display: none; place-items: center; }
  .lightbox[open] { display: grid; animation: fade 0.3s; }
  .lightbox::backdrop { background: rgba(74, 22, 38, 0.85); }
  @keyframes fade { from { opacity: 0; } }
  .lightbox__stage { width: min(92vw, 1000px); height: min(84svh, 900px); display: grid; place-items: center; }
  .lightbox__stage :global(img) {
    max-width: 92vw; max-height: min(84svh, 900px); width: auto; height: auto; border-radius: var(--radius-m); object-fit: contain;
  }
  .lightbox__nav, .lightbox__close {
    position: fixed; width: 52px; height: 52px; border-radius: 50%; border: 0;
    background: var(--milk); color: var(--berry); font-size: 2rem; line-height: 1; display: grid; place-items: center;
  }
  .lightbox__nav--prev { left: 16px; top: 50%; translate: 0 -50%; }
  .lightbox__nav--next { right: 16px; top: 50%; translate: 0 -50%; }
  .lightbox__close { top: 16px; right: 16px; }

  @media (max-width: 820px) {
    .gallery__head { grid-template-columns: 1fr; }
    .gallery__grid { columns: 2; }
    .lightbox__nav { top: auto; bottom: 20px; translate: none; }
  }
</style>
