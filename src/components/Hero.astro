---
import { site, nav } from '../data/site';
import Doodle from './Doodle.astro';
import Decor from './Decor.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import Icon from './Icon.astro';

const letters = site.brand.toUpperCase().split('');

// Ягоды живут только в пустых зонах: между меню и текстом, в центре между текстом и фото,
// в верхней строке. Координаты — доли карточки; m* — для телефона (m: false — скрыть).
type Berry = {
  n: 'strawberry' | 'blueberry' | 'raspberry' | 'cherry' | 'leaf' | 'sparkle';
  x: string; y: string; w: string; r: string;
  mx?: string; my?: string; mw?: string; m?: boolean;
};
const berries: Berry[] = [
  { n: 'strawberry', x: '8%',  y: '47%', w: 'clamp(54px, 6.2vw, 96px)', r: '-14deg', mx: '4%',  my: '1.2%', mw: '34px' },
  { n: 'blueberry',  x: '24%', y: '48%', w: 'clamp(24px, 2.6vw, 40px)', r: '0deg',   mx: '90%', my: '56%',  mw: '24px' },
  { n: 'raspberry',  x: '37%', y: '47%', w: 'clamp(40px, 4.6vw, 70px)', r: '18deg',  mx: '76%', my: '57%',  mw: '32px' },
  { n: 'cherry',     x: '46%', y: '45%', w: 'clamp(46px, 5.4vw, 82px)', r: '-8deg',  mx: '40%', my: '1.4%', mw: '32px' },
  { n: 'leaf',       x: '17%', y: '57%', w: 'clamp(34px, 4vw, 62px)',   r: '30deg',  mx: '16%', my: '1.2%', mw: '28px' },
  { n: 'sparkle',    x: '31%', y: '53%', w: 'clamp(18px, 1.8vw, 28px)', r: '0deg',   mx: '29%', my: '2.4%', mw: '16px' },
  { n: 'strawberry', x: '56%', y: '69%', w: 'clamp(40px, 4.4vw, 68px)', r: '22deg',  mx: '2%',  my: '76%',  mw: '32px' },
  { n: 'blueberry',  x: '62%', y: '80%', w: 'clamp(22px, 2.4vw, 36px)', r: '0deg',   mx: '90%', my: '84%',  mw: '22px' },
  { n: 'raspberry',  x: '54%', y: '89%', w: 'clamp(34px, 3.8vw, 58px)', r: '-16deg', mx: '88%', my: '91%',  mw: '30px' },
  { n: 'sparkle',    x: '64%', y: '74%', w: 'clamp(16px, 1.6vw, 24px)', r: '0deg',   m: false },
  { n: 'cherry',     x: '66%', y: '1.5%', w: 'clamp(30px, 3.2vw, 48px)', r: '12deg', m: false },
  { n: 'leaf',       x: '40%', y: '2%',   w: 'clamp(26px, 2.8vw, 42px)', r: '-24deg', m: false },
  { n: 'strawberry', x: '4%',  y: '59%', w: 'clamp(28px, 3.2vw, 48px)', r: '-20deg', mx: '3%', my: '90%', mw: '28px' },
  { n: 'blueberry',  x: '55%', y: '2.5%', w: 'clamp(20px, 2.2vw, 32px)', r: '0deg',  m: false },
  { n: 'raspberry',  x: '75%', y: '1.5%', w: 'clamp(30px, 3.2vw, 48px)', r: '10deg', m: false },
  { n: 'leaf',       x: '42%', y: '59%', w: 'clamp(26px, 2.8vw, 42px)', r: '48deg',  m: false },
];
---

<header class="hero" id="top">
  <div class="hero__frame container">
    <div class="hero__card">
      <Doodle variant="swirl" class="hero__doodle hero__doodle--a" />
      <Doodle variant="loop" class="hero__doodle hero__doodle--b" />

      <div class="hero__top">
        <span class="hero__meta">{site.role} · {site.city}</span>
        <a href="#contacts" class="btn hero__cta-top">Заказать</a>
      </div>

      <h1 class="hero__word" aria-label={`${site.brand} — ${site.role}`}>
        {letters.map((l, i) => <span class="hero__letter" style={`--i:${i}`} aria-hidden="true">{l}</span>)}
      </h1>

      <nav class="hero__nav" aria-label="Разделы">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>

      <div class="hero__bottom">
        <div class="hero__lead" data-hero-lead>
          <p class="hero__tagline">{site.tagline}</p>
          <div class="hero__actions">
            <a href="#fillings" class="btn">Выбрать начинку <Icon name="arrow" /></a>
            <a href="#contacts" class="btn btn--ghost">Написать мне</a>
          </div>
        </div>
        <div class="hero__visual" data-hero-visual>
          <span class="hero__note hand">всегда свежие ягоды</span>
          <Doodle variant="arrow" class="hero__note-arrow" />
          <Doodle variant="loop" class="hero__frame-loop" />
          <Image class="hero__photo" src={portrait} alt={`${site.name} — ${site.role}`} widths={[320, 480, 640]} sizes="(max-width: 820px) 70vw, 380px" loading="eager" />
        </div>
      </div>

      {berries.map((b, i) => (
        <Decor
          name={b.n}
          bob
          class:list={['hero__berry', { 'hero__berry--no-m': b.m === false }]}
          style={`--x:${b.x};--y:${b.y};--w:${b.w};--r:${b.r};--mx:${b.mx ?? b.x};--my:${b.my ?? b.y};--mw:${b.mw ?? b.w}`}
        />
      ))}
    </div>
  </div>
</header>

<style>
  .hero { padding-top: clamp(12px, 2vw, 24px); }
  .hero__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-l);
    background:
      radial-gradient(120% 80% at 80% 110%, var(--blush) 0%, transparent 60%),
      radial-gradient(90% 70% at 0% 0%, #fff 0%, transparent 60%),
      var(--milk);
    border: 1.5px solid var(--line);
    padding: clamp(16px, 3vw, 36px) clamp(16px, 3.5vw, 48px) clamp(28px, 4vw, 56px);
    min-height: min(92svh, 860px);
    display: flex;
    flex-direction: column;
  }
  .hero__doodle { position: absolute; color: var(--rose); opacity: 0.8; }
  .hero__doodle--a { width: 70%; height: 46%; left: -6%; top: 8%; }
  .hero__doodle--b { width: 40%; height: 70%; right: -8%; bottom: -14%; }

  .hero__top { position: relative; z-index: 2; display: flex; align-items: center; gap: 16px; }
  .hero__meta { font-size: var(--fs-small); color: var(--ink-soft); letter-spacing: 0.04em; text-transform: lowercase; }
  .hero__cta-top { margin-left: auto; min-height: 44px; padding: 0.6em 1.3em; }

  .hero__word {
    position: relative; z-index: 2;
    display: flex; justify-content: space-between;
    margin-top: clamp(20px, 3.4vw, 44px);
    font-size: var(--fs-display);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: var(--berry);
  }
  .hero__letter { display: inline-block; transform-origin: 50% 100%; }

  .hero__nav {
    position: relative; z-index: 2;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 18px;
    margin-top: clamp(14px, 2vw, 24px);
    padding-top: 12px;
    border-top: 1.5px solid var(--line);
    font-size: 0.95rem;
  }
  .hero__nav a { text-decoration: none; color: var(--berry); position: relative; }
  .hero__nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1.5px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.4s var(--ease-out);
  }
  .hero__nav a:hover::after { transform: scaleX(1); }

  .hero__bottom {
    position: relative; z-index: 2;
    margin-top: auto;
    display: grid; grid-template-columns: 1.1fr 1fr; align-items: end; gap: 24px;
    padding-top: 24px;
  }
  .hero__tagline { font-size: clamp(1.15rem, 2vw, 1.55rem); line-height: 1.35; max-width: 30ch; color: var(--ink); font-weight: 500; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .hero__visual { position: relative; justify-self: end; width: min(100%, clamp(240px, 23vw, 310px)); margin-top: 28px; }
  .hero__visual :global(.hero__photo) {
    position: relative; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 35% 30%;
    border-radius: 46% 54% 32px 32px / 34% 34% 32px 32px;
    border: 1.5px solid var(--berry); box-shadow: var(--shadow-lift);
    transform: rotate(2deg);
  }
  .hero__frame-loop { position: absolute; inset: -8% -10% -4% -8%; width: 118%; height: 112%; color: var(--rose); }
  .hero__note { position: absolute; top: 40px; left: -150px; font-size: 1.7rem; color: var(--berry); transform: rotate(-8deg); }
  .hero__note-arrow { position: absolute; top: 76px; left: -64px; width: 70px; height: 54px; }

  .hero__berry { z-index: 1; left: var(--x); top: var(--y); width: var(--w); rotate: var(--r); }

  @media (max-width: 820px) {
    .hero__card { min-height: auto; }
    .hero__meta, .hero__doodle--a { display: none; }
    .hero__nav { justify-content: flex-start; font-size: 0.9rem; }
    .hero__bottom { grid-template-columns: 1fr; padding-top: 28px; }
    .hero__visual { justify-self: center; width: min(78%, 280px); margin-top: 24px; }
    .hero__note { left: -14px; top: -34px; font-size: 1.4rem; }
    .hero__note-arrow { display: none; }
    .hero__berry { left: var(--mx); top: var(--my); width: var(--mw); }
    .hero__berry--no-m { display: none; }
  }
</style>
