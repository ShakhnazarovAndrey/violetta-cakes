---
import { site } from '../data/site';
---

<div class="sticky" data-sticky>
  <a class="btn sticky__btn" href={site.contacts.telegramUrl} target="_blank" rel="noopener">Заказать торт</a>
</div>

<style>
  .sticky {
    position: fixed; left: 16px; right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); z-index: 50;
    display: none; transform: translateY(140%); transition: transform 0.5s var(--ease-spring);
  }
  .sticky.is-visible { transform: none; }
  .sticky__btn { width: 100%; box-shadow: var(--shadow-lift); }
  @media (max-width: 820px) { .sticky { display: block; } }
</style>
