---
import { site } from '../data/site';
import Icon from './Icon.astro';
const c = site.contacts;
---

<div class="sticky" data-sticky>
  <button type="button" class="btn sticky__btn" data-open-sheet>Заказать торт</button>
</div>

<dialog class="sheet" data-sheet aria-label="Выберите мессенджер">
  <div class="sheet__inner">
    <span class="sheet__grip" aria-hidden="true"></span>
    <p class="sheet__title">Где вам удобнее написать?</p>
    <a class="btn" href={`https://wa.me/${c.whatsapp}`} target="_blank" rel="noopener" data-order="wa"><Icon name="whatsapp" /> WhatsApp</a>
    <a class="btn btn--ghost" href={`https://t.me/${c.telegram}`} target="_blank" rel="noopener" data-order="tg"><Icon name="telegram" /> Telegram</a>
    <a class="btn btn--ghost" href={`https://instagram.com/${c.instagram}`} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram</a>
    <button type="button" class="sheet__close" data-close>Закрыть</button>
  </div>
</dialog>

<style>
  .sticky {
    position: fixed; left: 16px; right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); z-index: 50;
    display: none; transform: translateY(140%); transition: transform 0.5s var(--ease-spring);
  }
  .sticky.is-visible { transform: none; }
  .sticky__btn { width: 100%; box-shadow: var(--shadow-lift); }
  @media (max-width: 820px) { .sticky { display: block; } }

  .sheet { width: 100vw; margin: auto 0 0; }
  .sheet[open] { animation: up 0.45s var(--ease-out); }
  @keyframes up { from { transform: translateY(100%); } }
  .sheet__inner {
    display: grid; gap: 10px; padding: 14px 20px max(20px, env(safe-area-inset-bottom));
    background: var(--milk); border-radius: var(--radius-l) var(--radius-l) 0 0;
  }
  .sheet__grip { justify-self: center; width: 44px; height: 5px; border-radius: 9px; background: var(--line); margin-bottom: 8px; }
  .sheet__title { font-weight: 800; font-size: 1.3rem; color: var(--berry); margin-bottom: 6px; }
  .sheet__close { background: none; border: 0; padding: 12px; color: var(--ink-soft); }
</style>
