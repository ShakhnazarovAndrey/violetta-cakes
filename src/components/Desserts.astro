---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';

const desserts = (await getCollection('desserts')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section desserts" id="desserts">
  <div class="container">
    <SectionTitle solid="Другие" ghost="десерты" align="center" />
    <p class="desserts__lead" data-reveal>Не только торты: десерты в стаканчиках, наборы и сладости к столу.</p>

    <ul class="desserts__grid">
      {desserts.map(({ data }) => (
        <li class="dessert" data-reveal>
          <div class="dessert__pic">
            <Image src={data.image} alt={data.name} widths={[360, 560, 800]} sizes="(max-width: 700px) 90vw, 380px" style={`object-position: ${data.focus}`} />
            {data.price && <span class="price-badge dessert__badge">{data.price}</span>}
          </div>

          <h3>{data.name}</h3>
          {data.priceNote && <p class="dessert__note">{data.priceNote}</p>}

          {data.tiers.length > 0 && (
            <dl class="dessert__tiers">
              {data.tiers.map((t) => (
                <div><dt>{t.qty}</dt><dd>{t.price}</dd></div>
              ))}
            </dl>
          )}
          {data.tiersNote && <p class="dessert__note">{data.tiersNote}</p>}

          {data.groups.map((g) => (
            <div class="dessert__group">
              <span class="dessert__group-title">{g.title}</span>
              <ul class="dessert__chips">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}

          {data.notes.length > 0 && (
            <ul class="dessert__list">
              {data.notes.map((n) => <li>{n}</li>)}
            </ul>
          )}

          <a class="btn btn--ghost dessert__btn" href="#contacts" data-order="wa" data-kind={data.orderAs}>
            Заказать <Icon name="arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .desserts__lead { max-width: 52ch; margin: 20px auto 0; text-align: center; color: var(--ink-soft); }
  .desserts__grid {
    list-style: none; margin: clamp(36px, 5vw, 64px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(36px, 5vw, 64px) clamp(20px, 3vw, 40px);
  }
  .dessert { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; min-width: 0; }
  .dessert__pic {
    position: relative; width: 100%; aspect-ratio: 1; margin-bottom: 6px;
    border-radius: 46% 54% 32px 32px / 30% 30% 32px 32px; overflow: hidden; background: var(--blush);
    transition: transform 0.6s var(--ease-spring), box-shadow 0.4s;
  }
  .dessert:hover .dessert__pic { transform: translateY(-6px) rotate(-1deg); box-shadow: var(--shadow-lift); }
  .dessert__pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .dessert__badge { position: absolute; right: 12px; bottom: 12px; background: var(--milk); }
  .dessert h3 { font-size: var(--fs-h3); font-weight: 800; letter-spacing: -0.02em; color: var(--berry); }
  .dessert__note { font-size: 0.92rem; color: var(--ink-soft); }

  .dessert__tiers { margin: 2px 0 0; padding: 0; width: 100%; max-width: 280px; display: grid; gap: 6px; }
  .dessert__tiers div { display: flex; align-items: baseline; gap: 10px; }
  .dessert__tiers div::after { content: ''; order: 1; flex: 1; border-bottom: 2px dotted var(--rose); transform: translateY(-4px); }
  .dessert__tiers dt { order: 0; font-weight: 500; }
  .dessert__tiers dd { order: 2; margin: 0; font-weight: 800; color: var(--berry); }

  .dessert__group { display: grid; gap: 6px; }
  .dessert__group-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-soft); }
  .dessert__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .dessert__chips li { padding: 0.25em 0.8em; border: 1.5px solid var(--line); border-radius: 999px; font-size: 0.88rem; color: var(--berry); background: var(--milk); }

  .dessert__list { margin: 2px 0 0; padding-left: 1.1em; color: var(--ink-soft); font-size: 0.92rem; }
  .dessert__list li::marker { color: var(--rose); }
  .dessert__btn { margin-top: auto; align-self: flex-start; }

  @media (max-width: 980px) { .desserts__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .desserts__grid { grid-template-columns: minmax(0, 1fr); } .dessert__pic { max-width: 420px; } }
</style>
