---
interface Props { name: 'telegram' | 'whatsapp' | 'instagram' | 'arrow' | 'close' | 'plus' | 'phone'; }
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'telegram' && <path d="M21.5 4.5 2.8 11.7c-.9.4-.9 1.6.1 1.9l4.7 1.5 1.8 5.6c.3.8 1.3 1 1.9.4l2.6-2.5 4.8 3.5c.7.5 1.7.1 1.9-.7L23 5.9c.2-1-.6-1.8-1.5-1.4ZM7.7 15l10-7.3-7.6 8.4" />}
  {name === 'whatsapp' && (
    <>
      <path d="M3.5 20.5 4.8 16A8.5 8.5 0 1 1 8 19.3l-4.5 1.2Z" />
      <path d="M9 8.6c.2-.5.5-.6.9-.6h.5c.2 0 .4.1.5.4l.7 1.6c.1.3 0 .5-.1.7l-.5.6c.6 1.2 1.6 2.1 2.8 2.7l.6-.6c.2-.2.4-.2.7-.1l1.6.7c.3.1.4.3.4.6v.4c0 .5-.2.8-.6 1-1 .5-2.4.5-4.5-1s-3.3-3.4-3.5-4.5c-.2-.9.2-1.5.5-1.9Z" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'arrow' && <path d="M5 12h14m-5-6 6 6-6 6" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
</svg>
