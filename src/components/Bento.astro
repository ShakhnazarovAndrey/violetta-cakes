---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { bento, site } from '../data/site';
import SectionTitle from './SectionTitle.astro';
import FillingCard from './FillingCard.astro';
import Doodle from './Doodle.astro';
import Icon from './Icon.astro';
import tier1 from '../assets/bento/tier-1.jpg';
import tier2 from '../assets/bento/tier-2.jpg';
import tier3 from '../assets/bento/tier-3.jpg';
import sizeM from '../assets/bento/size-m.jpg';

const tierImages = [tier1, tier2, tier3];

const fillings = (await getCollection('fillings'))
  .filter((f) => f.data.type === 'бенто')
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="section bento" id="bento">
  <div class="container">
    <SectionTitle solid="Бенто" ghost="торты" align="center" />
    <p class="bento__lead" data-reveal>{bento.lead}</p>

    <h3 class="size" data-reveal>
      <span class="size__label">Размер</span>
      <b class="size__letter">S</b>
      <small class="size__weight">{bento.s.weight}</small>
    </h3>

    <ul class="tiers">
      {bento.s.tiers.map((t, i) => (
        <li class="tier" data-reveal style={`--i:${i}`}>
          <div class="tier__pic">
            <Doodle variant="loop" class="tier__loop" />
            <Image src={tierImages[i]} alt={`Бенто-торт: ${t.title}`} widths={[240, 360]} sizes="(max-width: 700px) 60vw, 320px" />
          </div>
          <span class="price-badge">{t.price}</span>
          <h4>{t.title}</h4>
          <p>{t.text}</p>
        </li>
      ))}
    </ul>

    <h3 class="size size--m" data-reveal>
      <span class="size__label">Размер</span>
      <b class="size__letter">M</b>
      <small class="size__weight">{bento.m.weight}</small>
    </h3>

    <div class="msize" data-reveal>
      <div class="msize__pic">
        <Doodle variant="loop" class="tier__loop" />
        <Image src={sizeM} alt="Бенто-торт размера M" widths={[320, 480]} sizes="(max-width: 700px) 70vw, 340px" />
      </div>
      <div class="msize__text">
        <span class="price-badge msize__price">{bento.m.price}</span>
        <p>{bento.m.note}</p>
      </div>
    </div>

    <div class="bento__fill">
      <h3 class="bento__fill-title" data-split>Начинки <span>бенто</span></h3>
      <ul class="bento__grid">
        {fillings.map((entry) => <FillingCard entry={entry} compact />)}
      </ul>
      <div class="bento__cta" data-reveal>
        <a class="btn" href={site.contacts.telegramUrl} target="_blank" rel="noopener">Заказать бенто <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .bento__lead { max-width: 52ch; margin: 20px auto 0; text-align: center; color: var(--ink-soft); }

  .size { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 14px; margin: clamp(48px, 7vw, 88px) 0 0; font-weight: 400; }
  .size__label { font-size: clamp(1.4rem, 3vw, 2.2rem); letter-spacing: 0.04em; text-transform: uppercase; color: var(--berry); }
  .size__letter { font-size: clamp(3.2rem, 8vw, 6rem); font-weight: 900; line-height: 0.85; letter-spacing: -0.04em; color: var(--berry); }
  .size__weight { font-size: 1rem; color: var(--ink-soft); }
  .size--m { margin-top: clamp(56px, 8vw, 96px); }

  .tiers {
    list-style: none; margin: clamp(24px, 4vw, 40px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px);
  }
  .tier { display: grid; align-content: start; justify-items: start; gap: 10px; }
  .tier:nth-child(2) { margin-top: clamp(0px, 4vw, 48px); }
  .tier__pic { position: relative; width: 100%; aspect-ratio: 1; margin-bottom: 8px; transition: transform 0.6s var(--ease-spring); }
  .tier:hover .tier__pic { transform: translateY(-8px) rotate(-2deg); }
  .tier__pic :global(img), .msize__pic :global(img) {
    position: relative; width: 100%; height: 100%; object-fit: cover; border-radius: 42% 58% 46% 54% / 50% 44% 56% 50%;
  }
  .tier__pic :global(.tier__loop), .msize__pic :global(.tier__loop) { position: absolute; inset: -6%; width: 112%; height: 112%; color: var(--rose); }
  .tier h4 { font-size: var(--fs-h3); font-weight: 800; letter-spacing: -0.02em; color: var(--berry); }
  .tier p { color: var(--ink-soft); font-size: 0.95rem; max-width: 32ch; }

  .msize { display: grid; grid-template-columns: minmax(220px, 340px) 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; margin-top: clamp(24px, 4vw, 40px); }
  .msize__pic { position: relative; aspect-ratio: 1; }
  .msize__price { font-size: 1.1rem; padding: 0.45em 1.1em; }
  .msize__text p { margin-top: 14px; color: var(--ink-soft); max-width: 36ch; }

  .bento__fill { margin-top: clamp(64px, 9vw, 120px); }
  .bento__fill-title { font-size: var(--fs-h2); font-weight: 800; line-height: 0.95; letter-spacing: -0.035em; color: var(--berry); }
  .bento__fill-title span { color: var(--blush); -webkit-text-stroke: 1.5px var(--rose); paint-order: stroke fill; }
  .bento__grid {
    list-style: none; margin: clamp(28px, 4vw, 48px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: clamp(20px, 3vw, 36px) clamp(14px, 2vw, 28px);
  }
  .bento__cta { margin-top: clamp(32px, 5vw, 56px); }

  @media (max-width: 700px) {
    .tiers { grid-template-columns: 1fr; }
    .tier { grid-template-columns: 120px 1fr; column-gap: 16px; align-items: center; margin-top: 0 !important; }
    .tier__pic { grid-row: span 3; margin: 0; }
    .tier p { grid-column: 2; }
    .msize { grid-template-columns: 120px 1fr; gap: 16px; }
    .bento__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
