---
import { site } from '../data/site';
import SectionTitle from './SectionTitle.astro';
import Doodle from './Doodle.astro';
import Decor from './Decor.astro';
import { Image } from 'astro:assets';
import work from '../assets/gallery/03-frog.jpg';
import heart from '../assets/gallery/01-heart-18.jpg';
import bento from '../assets/gallery/05-bento-pink.jpg';

const visuals = ['strawberry', heart, bento] as const;
---

<section class="section about" id="about">
  <div class="container">
    <SectionTitle solid={`Меня зовут ${site.name}, и я`} ghost={site.role} align="right" stack />

    <div class="about__grid">
      <figure class="about__portrait" data-reveal>
        <div class="about__photo">
          <Image src={work} alt="Торт ручной работы" widths={[320, 480, 640]} sizes="(max-width: 820px) 70vw, 400px" />
        </div>
        <Doodle variant="loop" class="about__loop" />
        <figcaption class="hand">{site.about.signature}</figcaption>
      </figure>

      <ol class="about__points">
        {site.about.points.map((text, i) => (
          <li class="about__point" data-reveal style={`--i:${i}`}>
            <span class="about__num">{i + 1}</span>
            <div class="about__pic">
              {visuals[i] === 'strawberry'
                ? <Decor name="strawberry" class="about__decor" />
                : <Image src={visuals[i]} alt="" widths={[96, 192]} sizes="96px" />}
            </div>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>

    <p class="about__note" data-reveal>
      {site.about.note}
      <Doodle variant="underline" class="about__underline" width={2} />
    </p>
  </div>
</section>

<style>
  .about__grid {
    display: grid; grid-template-columns: minmax(260px, 0.9fr) 1.3fr; gap: clamp(32px, 6vw, 96px);
    align-items: center; margin-top: clamp(40px, 6vw, 80px);
  }
  .about__portrait { position: relative; margin: 0; justify-self: center; width: min(100%, 400px); }
  .about__photo {
    aspect-ratio: 4 / 5; border-radius: 50% 50% 46% 54% / 44% 44% 56% 56%;
    background: linear-gradient(160deg, var(--blush), var(--rose-soft));
    border: 1.5px solid var(--berry);
    overflow: hidden;
  }
  .about__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }
  .about__loop { position: absolute; inset: -8% -10% -6% -12%; width: 122%; height: 114%; color: var(--rose); }
  .about__portrait figcaption { position: absolute; top: calc(100% + 18px); left: 4%; font-size: 1.8rem; color: var(--berry); transform: rotate(-4deg); white-space: nowrap; }

  .about__points { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(20px, 3vw, 36px); }
  .about__point {
    display: grid; grid-template-columns: auto 96px 1fr; gap: 20px; align-items: center;
    padding-bottom: clamp(20px, 3vw, 36px); border-bottom: 1.5px dashed var(--line);
  }
  .about__point:nth-child(2) { margin-left: clamp(0px, 4vw, 56px); }
  .about__point:nth-child(3) { margin-left: clamp(0px, 8vw, 112px); border-bottom: 0; }
  .about__num {
    width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--berry);
    display: grid; place-items: center; font-weight: 700; color: var(--berry); background: var(--milk);
  }
  .about__pic { position: relative; width: 96px; aspect-ratio: 1; }
  .about__decor { position: static !important; width: 100%; }
  .about__pic :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 1.5px solid var(--berry); }
  .about__point p { max-width: 42ch; }

  .about__note {
    position: relative; margin-top: clamp(48px, 7vw, 96px); max-width: 26ch;
    font-size: clamp(1.4rem, 3vw, 2.2rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; color: var(--berry);
  }
  .about__underline { position: absolute; left: 0; bottom: -18px; width: 70%; height: 24px; color: var(--rose); }

  @media (max-width: 820px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__portrait { width: min(68%, 260px); margin-bottom: 64px; }
    .about__point { grid-template-columns: auto 64px 1fr; gap: 14px; margin-left: 0 !important; }
    .about__pic { width: 64px; }
  }
</style>
